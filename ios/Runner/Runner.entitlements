<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (Firebase Cloud Messaging). Xcode's export
	     switches it to production for TestFlight and the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple, offered on the sign-in screen. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Shared with the home-screen widget (AtlasWidget). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.atlas.atlasMobile</string>
	</array>
</dict>
</plist>
