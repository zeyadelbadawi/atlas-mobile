<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen: the white Atlas mark on Navy 600, the same frame the
     app's animated splash (lib/features/system/splash_screen.dart) opens on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/atlas_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/splash_mark" />
    </item>
</layer-list>
