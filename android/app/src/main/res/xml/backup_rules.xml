<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (allowBackup). Nothing is backed up: the session
     is device-only and everything else re-syncs from the server. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
